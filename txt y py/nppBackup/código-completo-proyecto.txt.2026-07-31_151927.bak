// src/components/Nav.tsx
"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { useAppContext } from "@/context/AppContext";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faSun, faMoon, faBars, faTimes } from "@fortawesome/free-solid-svg-icons";

export default function Nav() {
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [isScrolled, setIsScrolled] = useState(false);
  const pathname = usePathname();
  const { modo, tema, toggleTema } = useAppContext();

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 50);
    };
    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  const isDark = tema === "oscuro";
  
  const navBg = isDark 
    ? (isScrolled ? "bg-slate-900/95 backdrop-blur-sm" : "bg-slate-900/80 backdrop-blur-sm")
    : (isScrolled ? "bg-white/95 backdrop-blur-sm" : "bg-white/80 backdrop-blur-sm");

  const logoSrc = modo === "institucional" 
    ? "/images/aguila-blanco.png" 
    : "/images/leon-blanco.png";

  // ⭐ SOLUCIÓN: Definición dinámica de enlaces
  const getNavLinks = () => {
    const links = [
      { href: "/", label: "Inicio" },
      { href: "/sobre-mi", label: "Sobre Mí" },
    ];

    // ✅ Solo mostrar "Propuestas" en modo campaña
    if (modo === "campania") {
      links.push({ href: "/propuestas", label: "Propuestas" });
    }

    // ✅ Siempre mostrar estos enlaces
    links.push(
      { href: "/proyectos", label: "Proyectos" },
      { href: "/mapa", label: "Mapa" },
      { href: "/contacto", label: "Contacto" }
    );

    return links;
  };

  const navLinks = getNavLinks();

  const isActive = (path: string) => {
    if (path === "/") return pathname === "/";
    return pathname?.startsWith(path);
  };

  return (
    <nav className={`fixed w-full z-50 transition-all duration-300 ${navBg} border-b-3 border-b-(--color-destacado)`}>
      <div className="container mx-auto px-4">
        <div className="flex justify-between items-center h-20">
          {/* Logo */}
          <Link href="/" className="flex items-center gap-2">
            <img 
              src={logoSrc} 
              alt={modo === "institucional" ? "Giselle Miravete - Concejal" : "Giselle Miravete - Campaña"} 
              className="h-14 w-auto object-contain"
            />
          </Link>

          {/* Desktop Navigation */}
          <div className="hidden md:flex items-center gap-6">
            {navLinks.map((link) => (
              <Link
                key={link.href}
                href={link.href}
                className={`text-sm font-medium transition-colors hover:text-(--color-destacado) ${
                  isActive(link.href)
                    ? "text-(--color-destacado)"
                    : isDark 
                      ? "text-white/80" 
                      : "text-(--color-texto)/80"
                }`}
              >
                {link.label}
              </Link>
            ))}
            
            {/* Botón de tema */}
            <button
              onClick={toggleTema}
              className={`p-2 rounded-full transition-all hover:scale-110 ${
                isDark 
                  ? "bg-white/10 text-yellow-400 hover:bg-white/20" 
                  : "bg-gray-200/50 text-slate-700 hover:bg-gray-300/50"
              }`}
              aria-label="Cambiar tema"
            >
              <FontAwesomeIcon icon={isDark ? faSun : faMoon} className="w-5 h-5" />
            </button>
          </div>

          {/* Mobile Menu Button */}
          <button
            onClick={() => setIsMenuOpen(!isMenuOpen)}
            className="md:hidden p-2 rounded-lg hover:bg-gray-200/20 transition-colors"
            aria-label="Abrir menú"
          >
            <FontAwesomeIcon 
              icon={isMenuOpen ? faTimes : faBars} 
              className={`w-6 h-6 ${isDark ? "text-white" : "text-(--color-texto)"}`} 
            />
          </button>
        </div>

        {/* Mobile Navigation */}
        {isMenuOpen && (
          <div className="md:hidden py-4 border-t border-(--color-borde)/20">
            <div className="flex flex-col gap-3">
              {navLinks.map((link) => (
                <Link
                  key={link.href}
                  href={link.href}
                  onClick={() => setIsMenuOpen(false)}
                  className={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                    isActive(link.href)
                      ? "bg-(--color-destacado)/10 text-(--color-destacado)"
                      : isDark
                        ? "text-white/80 hover:bg-white/10"
                        : "text-(--color-texto)/80 hover:bg-gray-100"
                  }`}
                >
                  {link.label}
                </Link>
              ))}
              
              {/* Botón de tema en mobile */}
              <button
                onClick={toggleTema}
                className={`px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 ${
                  isDark
                    ? "text-yellow-400 hover:bg-white/10"
                    : "text-(--color-texto) hover:bg-gray-100"
                }`}
              >
                <FontAwesomeIcon icon={isDark ? faSun : faMoon} className="w-4 h-4" />
                {isDark ? "Modo claro" : "Modo oscuro"}
              </button>
            </div>
          </div>
        )}
      </div>
    </nav>
  );
}

