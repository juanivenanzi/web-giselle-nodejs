/* ══════════════════════════════════════════
   4 PALETAS COMPLETAS (ORIGINALES DEL PROYECTO ASTRO)
   ══════════════════════════════════════════ */

/* ── INSTITUCIONAL + CLARO (por defecto) ── */
:root {
  --color-primario: #1e3a5f;
  --color-primario-dark: #0f2744;
  --color-destacado: #74acdf;
  --color-destacado-fondo: var(--color-destacado);
  --color-destacado-pastilla: var(--color-destacado);
  --color-fondo: #ffffff;
  --color-fondo-alt: #f8f9fa;
  --color-texto: #1a1a2e;
  --color-texto-sec: #4a4a6a;
  --color-blanco-suave: rgba(255, 255, 255, 0.85);
  --color-borde: #94a3b8;
  --color-nav: rgba(255, 255, 255, 0.85);
  --color-nav-scrolled: #1e3a5f;
  --color-rol: #1a3a6a;
}

/* ── INSTITUCIONAL + OSCURO ── */
[data-modo="institucional"][data-tema="oscuro"] {
  --color-primario: #1a3352;
  --color-primario-dark: #0c1e35;
  --color-destacado: #8fc4e8;
  --color-destacado-fondo: var(--color-destacado);
  --color-destacado-pastilla: var(--color-destacado);
  --color-fondo: #0f172a;
  --color-fondo-alt: #1e293b;
  --color-texto: #f1f5f9;
  --color-texto-sec: #cbd5e1;
  --color-borde: #64748b;
  --color-nav: rgba(15, 23, 42, 0.85);
  --color-nav-scrolled: #1a3352;
  --color-rol: #a8d4f0;
}

/* ── CAMPAÑA + CLARO ── */
[data-modo="campaña"] {
  --color-primario: #6c3fa0;
  --color-primario-dark: #4c1d95;
  --color-destacado: #d4a017;
  --color-destacado-fondo: #96750f;
  --color-destacado-pastilla: #ddb830;
  --color-fondo: #ffffff;
  --color-fondo-alt: #f0e8ff;
  --color-texto: #1a1a1a;
  --color-texto-sec: #374151;
  --color-borde: #9a8ab0;
  --color-nav: rgba(255, 255, 255, 0.85);
  --color-nav-scrolled: #6c3fa0;
  --color-rol: #3a2a7a;
}

/* ── CAMPAÑA + OSCURO ── */
[data-modo="campaña"][data-tema="oscuro"] {
  --color-primario: #4c1d95;
  --color-primario-dark: #2e1065;
  --color-destacado: #f0c040;
  --color-destacado-fondo: #a08015;
  --color-destacado-pastilla: #d4a017;
  --color-fondo: #1a1025;
  --color-fondo-alt: #2d1b4e;
  --color-texto: #f1f5f9;
  --color-texto-sec: #c4b5fd;
  --color-borde: #7a6a9a;
  --color-nav: rgba(26, 16, 37, 0.85);
  --color-nav-scrolled: #4c1d95;
  --color-rol: #d4c0f0;
}

/* ══════════════════════════════════════════
   UTILIDADES PERSONALIZADAS
   ══════════════════════════════════════════ */
.t-modo {
  transition:
    background-color 0.6s ease,
    color 0.6s ease,
    border-color 0.6s ease,
    box-shadow 0.6s ease;
}

.font-head {
  font-family: "DM Serif Display", Georgia, serif;
}

.font-body {
  font-family: "Inter", system-ui, sans-serif;
}

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.reveal-visible {
  opacity: 1;
  transform: translateY(0);
}

.reveal-delay-1 {
  transition-delay: 0.1s;
}
.reveal-delay-2 {
  transition-delay: 0.2s;
}
.reveal-delay-3 {
  transition-delay: 0.3s;
}
.reveal-delay-4 {
  transition-delay: 0.4s;
}

/* ══════════════════════════════════════════
   BASE GLOBAL
   ══════════════════════════════════════════ */
html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", system-ui, sans-serif;
  background-color: var(--color-fondo);
  color: var(--color-texto);
  transition:
    background-color 0.6s ease,
    color 0.6s ease;
}

/* ══════════════════════════════════════════
   SKIP LINK - ACCESIBILIDAD
   ══════════════════════════════════════════ */
.skip-link {
  position: fixed;
  top: 0;
  left: 50%;
  padding: 12px 24px;
  background-color: var(--color-primario);
  color: #ffffff;
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: 0 0 12px 12px;
  z-index: 9999;
  transform: translateX(-50%) translateY(-100%);
  transition: transform 0.2s ease;
}

.skip-link:focus {
  transform: translateX(-50%) translateY(0);
}

/* ══════════════════════════════════════════
   ACCESIBILIDAD — Foco visible por teclado
   ══════════════════════════════════════════ */
:focus-visible {
  outline: 3px solid var(--color-destacado);
  outline-offset: 2px;
}

:focus:not(:focus-visible) {
  outline: none;
}

/* ══════════════════════════════════════════
   NAVEGACIÓN
   ══════════════════════════════════════════ */
.nav-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  height: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rem;
  background-color: var(--color-nav);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid
    color-mix(in srgb, var(--color-texto) 35%, transparent);
  transition:
    background-color 0.6s ease,
    color 0.6s ease,
    border-color 0.6s ease,
    box-shadow 0.6s ease;
}

.nav-container .nav-link {
  color: var(--color-texto);
  font-size: 0.875rem;
  font-weight: 500;
  transition: color 0.3s ease;
  border-bottom: 2px solid transparent;
}

.nav-container .nav-link:hover {
  border-bottom-color: var(--color-destacado);
}

.hamburger-line {
  background-color: var(--color-texto);
  transition: all 0.3s ease;
}

.hamburger-open .line1 {
  transform: translateY(8px) rotate(45deg);
}

.hamburger-open .line2 {
  opacity: 0;
}

.hamburger-open .line3 {
  transform: translateY(-8px) rotate(-45deg);
}

.mobile-menu {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-in-out;
}

.mobile-menu.open {
  max-height: 400px;
}

.mobile-link {
  color: var(--color-texto);
  transition:
    background-color 0.2s ease,
    color 0.2s ease;
}

.mobile-link:hover {
  background-color: color-mix(in srgb, var(--color-texto) 10%, transparent);
}

/* ══════════════════════════════════════════
   FOOTER
   ══════════════════════════════════════════ */
.footer {
  padding: 1rem 2rem;
  background-color: var(--color-primario-dark);
  transition:
    background-color 0.6s ease,
    color 0.6s ease,
    border-color 0.6s ease,
