// src/context/AppContext.tsx
"use client";

import {
  createContext,
  useContext,
  useState,
  useEffect,
  ReactNode,
} from "react";

type Modo = "institucional" | "campania";
type Tema = "claro" | "oscuro";

interface AppContextType {
  modo: Modo;
  tema: Tema;
  setModo: (modo: Modo) => void;
  setTema: (tema: Tema) => void;
  toggleTema: () => void;
}

const AppContext = createContext<AppContextType | undefined>(undefined);

export function AppProvider({ children }: { children: ReactNode }) {
  const [modo, setModo] = useState<Modo>("campania");
  const [tema, setTema] = useState<Tema>("claro");

  useEffect(() => {
    const storedModo = localStorage.getItem("modo") as Modo | null;
    const storedTema = localStorage.getItem("tema") as Tema | null;

    if (storedModo) setModo(storedModo);
    if (storedTema) setTema(storedTema);
  }, []);

  useEffect(() => {
    document.documentElement.setAttribute("data-modo", modo);
    document.documentElement.setAttribute("data-tema", tema);
    localStorage.setItem("modo", modo);
    localStorage.setItem("tema", tema);
  }, [modo, tema]);

  const toggleTema = () => {
    setTema((prev) => (prev === "claro" ? "oscuro" : "claro"));
  };

  return (
    <AppContext.Provider value={{ modo, tema, setModo, setTema, toggleTema }}>
      {children}
    </AppContext.Provider>
  );
}

// ✅ ESTA ES LA LÍNEA QUE FALTA - Asegúrate que está presente
export function useAppContext() {
  const context = useContext(AppContext);
  if (context === undefined) {
    throw new Error("useAppContext must be used within an AppProvider");
  }
  return context;
}


