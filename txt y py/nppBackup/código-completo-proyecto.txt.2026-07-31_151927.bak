                      >
                        {a.label}
                      </li>
                    ))}
                  </ul>
                )}
                {/* ✅ TEXTO GUÍA */}
                <p
                  className="text-xs mt-1.5"
                  style={{ color: "var(--color-texto-sec)" }}
                >
