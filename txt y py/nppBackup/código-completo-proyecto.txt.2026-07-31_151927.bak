      return;
    }

    const requests = [];
    for (let i = 0; i < columnCount; i++) {
      requests.push({
        autoResizeDimensions: {
          dimensions: {
            sheetId: sheetId,
            dimension: "COLUMNS",
            startIndex: i,
            endIndex: i + 1,
          },
        },
      });
    }

    await sheets.spreadsheets.batchUpdate({
