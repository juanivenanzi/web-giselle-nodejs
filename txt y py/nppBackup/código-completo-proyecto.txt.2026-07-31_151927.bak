  color: var(--color-destacado);
}

.contador-resultados {
  font-family: "Inter", sans-serif;
  font-size: 1.1rem;
  font-weight: 400;
  color: color-mix(in srgb, #1a1a2e 85%, transparent);
  text-align: center;
  margin-top: 0.25rem;
  padding-top: 0.5rem;
  border-top: 2px solid;
  border-image: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, #1a1a2e 20%, transparent),
      transparent
    )
    1;
}

html[data-tema="oscuro"] .contador-resultados {
  color: var(--color-texto-sec);
}

html[data-tema="oscuro"] .contador-resultados strong {
  color: var(--color-texto);
}

.contador-resultados strong {
  color: #1a1a2e;
  font-weight: 700;
}

/* ══════════════════════════════════════════
   TARJETAS DE GESTIÓN
   ══════════════════════════════════════════ */
.grid-tarjetas {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.gestion-card {
  background-color: var(--color-fondo-alt);
  border-radius: 1rem;
  padding: 1.5rem;
  border: 2px solid var(--color-borde);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.gestion-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-destacado);
  box-shadow: 0 6px 0 0 var(--color-destacado);
}

.gestion-card .cabecera {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-bottom: 0.5rem;
  gap: 0.5rem;
  flex-wrap: nowrap;
}

.gestion-card .tipo {
  font-family: "Inter", sans-serif;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background-color: var(--color-primario);
  color: #ffffff;
  padding: 0.15rem 0.6rem;
  border-radius: 9999px;
  white-space: nowrap;
  flex-shrink: 0;
}

.gestion-card .estado {
  font-family: "Inter", sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.15rem 0.7rem;
  border-radius: 9999px;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  border: none !important;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ✅ Colores de estado - Texto en BLANCO para probar */
.estado-aprobada {
  background-color: #16a34a !important;
  color: #ffffff !important; /* ✅ Blanco */
}

.estado-no-aprobada {
  background-color: #dc2626 !important;
  color: #ffffff !important; /* ✅ Blanco */
}

.estado-en-tratamiento {
  background-color: #ca8a04 !important;
  color: #ffffff !important; /* ✅ Blanco */
}

.estado-en-comision {
  background-color: #2563eb !important;
  color: #ffffff !important; /* ✅ Blanco */
}

.estado-vetada {
  background-color: #7c3aed !important;
  color: #ffffff !important; /* ✅ Blanco */
}

.gestion-card .fecha {
  font-family: "Inter", sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--color-texto);
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.gestion-card .fecha i {
  font-size: 0.75rem;
  color: var(--color-texto);
}

.gestion-card .titulo {
  font-family: "DM Serif Display", Georgia, serif;
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--color-texto);
}

.gestion-card .descripcion {
  font-family: "Inter", sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-texto-sec);
  line-height: 1.625;
  flex: 1;
  min-height: 1.5rem;
}

.gestion-card .btn-expediente {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.5rem 1.2rem;
  border-radius: 9999px;
  background-color: var(--color-texto);
  color: #ffffff;
  font-family: "Inter", sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  margin-top: 1rem;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  width: fit-content;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  text-decoration: none;
}

.gestion-card .btn-expediente:hover {
  transform: scale(1.04);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15);
}

.gestion-card .btn-expediente i {
  font-size: 0.8rem;
}

html[data-tema="oscuro"] .gestion-card .btn-expediente {
  background-color: #ffffff;
  color: #000000;
}

/* ══════════════════════════════════════════
   REDES SOCIALES
   ══════════════════════════════════════════ */
.red-social {
  transition: all 0.25s ease;
}

.red-social:hover {
  background-color: var(--color-texto) !important;
  color: var(--color-fondo) !important;
  border-color: var(--color-texto) !important;
  transform: translateY(-2px);
}

/* ══════════════════════════════════════════
   TARJETAS DE EQUIPO
   ══════════════════════════════════════════ */
.foto-equipo {
  transition: all 0.3s ease;
}

.group:hover .foto-equipo {
  border-color: var(--color-destacado);
  box-shadow: 0 5px 0 0 var(--color-destacado);
}

/* ══════════════════════════════════════════
   PILARES
   ══════════════════════════════════════════ */
.pilar-card {
  transition: all 0.3s ease;
}

.pilar-card:hover {
  border-color: var(--color-destacado);
  transform: translateY(-4px);
}

/* ══════════════════════════════════════════
   MODO INSTITUCIONAL / CAMPAÑA
   ══════════════════════════════════════════ */
.contenido-institucional,
.contenido-campaña {
  display: none;
}

[data-modo="institucional"] .contenido-institucional {
  display: block;
}

[data-modo="campaña"] .contenido-campaña {
  display: block;
}

/* ══════════════════════════════════════════
   FORMULARIOS — ESTILOS PROFESIONALES
   ══════════════════════════════════════════ */
.form-group {
  position: relative;
}

.form-group label {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: 0.875rem;
  color: var(--color-texto-sec);
  transition: all 0.2s ease;
  pointer-events: none;
  background-color: transparent;
}

.form-group textarea ~ label {
  top: 1.2rem;
  transform: translateY(0);
}

.form-group input:focus ~ label,
.form-group input:not(:placeholder-shown) ~ label,
.form-group textarea:focus ~ label,
.form-group textarea:not(:placeholder-shown) ~ label {
  top: 0;
  transform: translateY(-50%);
  font-size: 0.65rem;
  background-color: var(--color-fondo);
  padding: 0 0.25rem;
  color: var(--color-texto);
  font-weight: 600;
}

/* ══════════════════════════════════════════
   DROPDOWN ASUNTO - ESTILOS PROFESIONALES
   ══════════════════════════════════════════ */
.asunto-dropdown {
  position: relative;
}

.asunto-dropdown .dropdown-btn {
  width: 100%;
  padding: 0.875rem 1rem;
  border-radius: 0.75rem;
  border: 2px solid var(--color-borde);
  background-color: var(--color-fondo);
  color: var(--color-texto-sec);
  font-size: 0.875rem;
  text-align: left;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  appearance: none;
}

.asunto-dropdown .dropdown-btn:hover {
  border-color: var(--color-texto-sec);
}

.asunto-dropdown .dropdown-btn:focus {
  outline: none;
  border-color: var(--color-texto);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-texto) 20%, transparent);
}

.asunto-dropdown .dropdown-btn .icon {
  transition: transform 0.2s ease;
}

.asunto-dropdown .dropdown-btn .icon.open {
  transform: rotate(180deg);
}

.asunto-dropdown .floating-label {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: 0.875rem;
  color: var(--color-texto-sec);
  transition: all 0.2s ease;
  pointer-events: none;
  background-color: transparent;
  padding: 0 0.25rem;
  z-index: 1;
}

.asunto-dropdown .floating-label.active {
  top: 0;
  transform: translateY(-50%);
  font-size: 0.65rem;
  font-weight: 600;
  color: var(--color-texto);
  background-color: var(--color-fondo);
  padding: 0 0.25rem;
}

.asunto-dropdown .dropdown-list {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  max-height: 200px;
  overflow-y: auto;
  border: 2px solid var(--color-borde);
  border-radius: 0.75rem;
  background-color: var(--color-fondo);
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
  z-index: 50;
  opacity: 0;
  transform: translateY(-8px);
  transition: all 0.2s ease;
  pointer-events: none;
}

.asunto-dropdown .dropdown-list.open {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.asunto-dropdown .dropdown-list li {
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  color: var(--color-texto);
  cursor: pointer;
  transition: background-color 0.15s ease;
  list-style: none;
}

.asunto-dropdown .dropdown-list li:hover {
  background-color: var(--color-fondo-alt);
}

.asunto-dropdown .dropdown-list li:first-child {
  border-radius: 0.75rem 0.75rem 0 0;
}

.asunto-dropdown .dropdown-list li:last-child {
  border-radius: 0 0 0.75rem 0.75rem;
}

.asunto-dropdown .dropdown-list::-webkit-scrollbar {
  width: 6px;
}

.asunto-dropdown .dropdown-list::-webkit-scrollbar-track {
  background: transparent;
}

.asunto-dropdown .dropdown-list::-webkit-scrollbar-thumb {
  background-color: var(--color-borde);
  border-radius: 3px;
}

.asunto-dropdown .dropdown-list::-webkit-scrollbar-thumb:hover {
  background-color: var(--color-texto-sec);
}

/* ============================================================
   BOTÓN VOLUNTARIADO - ESTILOS GLOBALES
   ============================================================ */

.btn-voluntario {
  background-color: var(--color-texto);
  color: #ffffff;
  border: 2px solid var(--color-texto);
  transition: all 0.3s ease;
  cursor: pointer;
}

.btn-voluntario:hover:not(:disabled) {
  transform: scale(1.05);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15);
}

.btn-voluntario:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* ✅ Dark Mode: fondo blanco, borde blanco, texto azul oscuro */
html[data-tema="oscuro"] .btn-voluntario {
  background-color: #ffffff !important;
  color: #1a1a2e !important;
  border: 2px solid #ffffff !important;
}

/* ✅ Dark Mode Hover: solo escala, sin cambio de color */
html[data-tema="oscuro"] .btn-voluntario:hover:not(:disabled) {
  background-color: #ffffff !important;
  color: #1a1a2e !important;
  border-color: #ffffff !important;
  transform: scale(1.05);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15);
}

/* ============================================================
   BOTÓN ENVIAR - ESTILOS GLOBALES (para Contacto)
   ============================================================ */

.btn-enviar {
  background-color: var(--color-texto);
  color: #ffffff;
  border: 2px solid var(--color-texto);
  transition: all 0.3s ease;
  cursor: pointer;
}

.btn-enviar:hover:not(:disabled) {
  transform: scale(1.05);
}

.btn-enviar:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* ✅ Dark Mode: fondo blanco, borde blanco, texto azul oscuro */
html[data-tema="oscuro"] .btn-enviar {
  background-color: #ffffff !important;
  color: #1a1a2e !important;
  border: 2px solid #ffffff !important;
}

/* ✅ Dark Mode Hover: solo escala, sin cambio de color */
html[data-tema="oscuro"] .btn-enviar:hover:not(:disabled) {
  background-color: #ffffff !important;
  color: #1a1a2e !important;
  border-color: #ffffff !important;
  transform: scale(1.05);
}

/* ══════════════════════════════════════════
   ALTO CONTRASTE
   ══════════════════════════════════════════ */
@media (prefers-contrast: more) {
  :root {
    --color-texto: #000000;
    --color-texto-sec: #1a1a2e;
    --color-borde: #000000;
  }
  [data-modo="institucional"] {
    --color-fondo: #ffffff;
    --color-fondo-alt: #f0f0f0;
  }
  [data-modo="institucional"][data-tema="oscuro"] {
    --color-texto: #f1f5f9;
    --color-texto-sec: #d1d5db;
    --color-borde: #f1f5f9;
  }
  [data-modo="campaña"] {
    --color-fondo: #ffffff;
    --color-fondo-alt: #f0f0f0;
  }
  [data-modo="campaña"][data-tema="oscuro"] {
    --color-texto: #f1f5f9;
    --color-texto-sec: #d1d5db;
    --color-borde: #f1f5f9;
  }
}

/* ══════════════════════════════════════════
   RESPONSIVE MÓVIL
   ══════════════════════════════════════════ */
@media (max-width: 768px) {
  .grid-tarjetas {
    grid-template-columns: 1fr;
  }
  .pastilla-color {
    font-size: 0.75rem;
    padding: 0.3rem 0.6rem;
  }
  .filtro-fila .opciones {
    padding-left: 0;
  }
  .filtros-vertical {
    padding: 1rem;
  }
  .filtro-grupo {
    flex-direction: column;
    align-items: stretch;
  }
  .gestion-card {
    padding: 1rem;
  }
  .gestion-card .titulo {
    font-size: 1rem;
  }
  .gestion-card .descripcion {
    font-size: 0.85rem;
  }
  .gestion-card .btn-expediente {
    font-size: 0.75rem;
    padding: 0.4rem 1rem;
  }
}


