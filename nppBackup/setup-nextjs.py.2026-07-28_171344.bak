# app/components/Nav.tsx
nav_tsx = """'use client'

import { useState, useEffect } from 'react'
import Link from 'next/link'
import Image from 'next/image'

export default function Nav() {
  const [scrolled, setScrolled] = useState(false)
  const [mobileMenu, setMobileMenu] = useState(false)

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 60)
    }
    window.addEventListener('scroll', handleScroll)
    return () => window.removeEventListener('scroll', handleScroll)
  }, [])

  return (
    <nav className={`fixed top-0 left-0 right-0 z-50 h-18 flex items-center justify-between px-8 t-modo ${scrolled ? 'scrolled' : ''}`}
         style={{ backgroundColor: 'var(--color-nav)', backdropFilter: 'blur(16px)' }}>
      <Link href="/" className="flex items-center gap-2">
        <Image src="/images/aguila-blanca.png" alt="La Libertad Avanza" width={48} height={48} className="h-12 w-auto" />
        <span className="text-white font-bold text-lg">Giselle Miravete</span>
      </Link>

      <div className="hidden md:flex items-center gap-8">
        <Link href="/" className="text-white/75 hover:text-white transition-colors">Inicio</Link>
        <Link href="/#sobre-mi" className="text-white/75 hover:text-white transition-colors">Sobre Mí</Link>
        <Link href="/proyectos" className="text-white/75 hover:text-white transition-colors">Proyectos</Link>
        <Link href="/mapa" className="text-white/75 hover:text-white transition-colors">Mapa</Link>
        <Link href="/#contacto" className="text-white/75 hover:text-white transition-colors">Contacto</Link>
      </div>

      <button className="md:hidden text-white" onClick={() => setMobileMenu(!mobileMenu)}>
        {mobileMenu ? '✕' : '☰'}
      </button>

      {mobileMenu && (
        <div className="absolute top-18 left-0 right-0 bg-(--color-fondo) border-b border-(--color-borde) p-4 flex flex-col gap-4 md:hidden">
          <Link href="/" className="text-(--color-texto) hover:text-(--color-destacado)">Inicio</Link>
          <Link href="/#sobre-mi" className="text-(--color-texto) hover:text-(--color-destacado)">Sobre Mí</Link>
          <Link href="/proyectos" className="text-(--color-texto) hover:text-(--color-destacado)">Proyectos</Link>
          <Link href="/mapa" className="text-(--color-texto) hover:text-(--color-destacado)">Mapa</Link>
          <Link href="/#contacto" className="text-(--color-texto) hover:text-(--color-destacado)">Contacto</Link>
        </div>
      )}
    </nav>
  )
}
"""
create_file("app/components/Nav.tsx", nav_tsx)

