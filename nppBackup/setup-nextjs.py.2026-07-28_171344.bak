# setup.py
# Script de setup para Next.js + Tailwind + TypeScript
# Basado en documentación oficial de Next.js 14

import subprocess
import os
import sys
import json
import shutil
from pathlib import Path

# ============================================================
# CONFIGURACIÓN
# ============================================================

PROJECT_NAME = "web-giselle-nodejs"
NEXT_VERSION = "latest"  # Usará la última versión estable
TAILWIND_VERSION = "latest"

# ============================================================
# FUNCIONES
# ============================================================

def run_command(command, cwd=None):
    """Ejecuta un comando en la terminal y muestra la salida"""
    print(f"\n📌 Ejecutando: {command}")
    result = subprocess.run(command, shell=True, cwd=cwd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"❌ Error: {result.stderr}")
        sys.exit(1)
    print(result.stdout)
    return result.stdout

def create_directory(path):
    """Crea un directorio si no existe"""
    Path(path).mkdir(parents=True, exist_ok=True)

def create_file(path, content):
    """Crea un archivo con contenido"""
    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)
    print(f"✅ Archivo creado: {path}")

